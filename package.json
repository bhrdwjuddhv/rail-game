{
  "name": "rail-bharat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "client"
  ],
  "scripts": {
    "dev": "npm run dev -w @rail/client",
    "build": "npm run typecheck && npm run build -w @rail/client",
    "preview": "npm run preview -w @rail/client",
    "test": "vitest run",
    "typecheck": "tsc -p shared && tsc -p client",
    "textures": "npm run textures -w @rail/client",
    "models": "npm run models -w @rail/client"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
